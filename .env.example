# Copy to .env and fill in. Loaded by run.sh --push (never commit real secrets).
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx
# wiki node token = the id in .../wiki/<TOKEN>
FEISHU_WIKI_TOKEN=xxxxxxxx
# or a raw docx id instead of a wiki node:
# FEISHU_DOCX_TOKEN=xxxxxxxx

# Weekly GitHub CI report (ci_weekly_report.py). GitHub authentication reuses
# the host's `gh auth` login. GITHUB_TOKEN/GH_TOKEN is only an optional override.
# The Simpler index gets one idempotent link to the app-owned GitHub CI index.
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxx
# This value identifies the Simpler total-index document. It is deliberately
# separate from other report targets so the CI module cannot append to the
# wrong existing document. It is a document locator, not an auth credential.
# FEISHU_SIMPLER_INDEX_WIKI_TOKEN=xxxxxxxx
# or a raw Simpler index docx id:
# FEISHU_SIMPLER_INDEX_DOCX_TOKEN=xxxxxxxx
# Optional mapping from private runner id/name to an anonymous performance tier.
# CI_RUNNER_TIERS_JSON='{"1001":"standard","1002":"slow"}'
# CI_RUNNER_ANON_SALT=replace-with-a-random-local-value
# FEISHU_DOMAIN=hw-native-sys.feishu.cn

# Failure DM (notify_feishu.py): who to private-message when a run fails.
# NOTIFY_RECEIVE_ID is your Feishu open_id (ou_...) by default, or a tenant
# email if NOTIFY_RECEIVE_TYPE=email. Leave unset to disable (soft no-op).
# NOTIFY_RECEIVE_ID=ou_xxxxxxxxxxxxxxxx
# NOTIFY_RECEIVE_TYPE=open_id

# Optional CANN runtime override. The tracker otherwise discovers set_env.sh
# from ASCEND_HOME_PATH/CANN_HOME and standard /usr/local/Ascend locations.
# It sources this file inside every allocated task-submit benchmark job, so
# cron does not need to inherit an interactive shell's LD_LIBRARY_PATH.
# PERF_CANN_ENV_SCRIPT=/usr/local/Ascend/cann/set_env.sh
